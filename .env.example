# --- Spotify (https://developer.spotify.com/dashboard) ---
# Create an app, add the redirect URI below to the app's settings exactly.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Apple Music (requires an Apple Developer Program membership) ---
# Certificates, Identifiers & Profiles -> Keys -> create a key with "Media Services (MusicKit)".
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Path to the downloaded AuthKey_XXXXXXXXXX.p8 file
APPLE_PRIVATE_KEY_PATH=
# Optional: two-letter storefront override (otherwise read from your account), e.g. us, gb
APPLE_STOREFRONT=
